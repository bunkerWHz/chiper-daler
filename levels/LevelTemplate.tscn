[gd_scene format=3]

[node name="LevelTemplate" type="Node2D"]
editor_description = "Empty level authoring template. Duplicate into levels/<level_name>/. See docs/Level_Authoring.md."

[node name="Background" type="Node2D" parent="."]
z_index = -100

[node name="Sky" type="Sprite2D" parent="Background"]

[node name="FarBackground" type="Parallax2D" parent="Background"]
scroll_scale = Vector2(0.2, 0.2)

[node name="NearBackground" type="Parallax2D" parent="Background"]
scroll_scale = Vector2(0.5, 0.5)

[node name="Terrain" type="Node2D" parent="."]

[node name="BackDecor" type="TileMapLayer" parent="Terrain"]
z_index = -20
collision_enabled = false
navigation_enabled = false

[node name="Solid" type="TileMapLayer" parent="Terrain"]
navigation_enabled = false

[node name="OneWayPlatforms" type="TileMapLayer" parent="Terrain"]
editor_description = "Configure one-way collision on tiles in the TileSet; this node name does not enable it."
navigation_enabled = false

[node name="FrontDecor" type="TileMapLayer" parent="Terrain"]
z_index = 20
collision_enabled = false
navigation_enabled = false

[node name="Objects" type="Node2D" parent="."]

[node name="Platforms" type="Node2D" parent="Objects"]

[node name="Climbables" type="Node2D" parent="Objects"]

[node name="Interactables" type="Node2D" parent="Objects"]

[node name="Checkpoints" type="Node2D" parent="Objects"]

[node name="Hazards" type="Node2D" parent="Objects"]

[node name="Actors" type="Node2D" parent="."]
editor_description = "Place or spawn the player here. Container only; no automatic spawning."

[node name="Enemies" type="Node2D" parent="Actors"]

[node name="NPCs" type="Node2D" parent="Actors"]

[node name="Pickups" type="Node2D" parent="."]

[node name="SpawnPoints" type="Node2D" parent="."]

[node name="DefaultSpawn" type="Marker2D" parent="SpawnPoints"]
editor_description = "Authoring marker only. Connect to level entry logic when implementing the playable level."

[node name="Transitions" type="Node2D" parent="."]

[node name="Triggers" type="Node2D" parent="."]

[node name="CameraBounds" type="Node2D" parent="."]
editor_description = "Container for camera bounds/zones. Does not constrain a camera by itself."

[node name="Atmosphere" type="Node2D" parent="."]

[node name="Lighting" type="Node2D" parent="Atmosphere"]

[node name="Particles" type="Node2D" parent="Atmosphere"]

[node name="Audio" type="Node" parent="Atmosphere"]

[node name="HUD" type="CanvasLayer" parent="."]
editor_description = "Mount a reusable HUD scene here if the game session does not already own it."
layer = 10
