[gd_resource type="Resource" load_steps=4 format=3]

[ext_resource type="Script" path="res://features/inventory/ItemData.gd" id="1_item"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemEquipmentProfile.gd" id="2_equipment"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemAmmunitionProfile.gd" id="3_ammunition"]

[sub_resource type="Resource" id="ItemEquipmentProfile_arrows"]
script = ExtResource("2_equipment")
allowed_slots = Array[int]([2])

[sub_resource type="Resource" id="ItemAmmunitionProfile_arrows"]
script = ExtResource("3_ammunition")
ammunition_type = &"arrow"

[resource]
script = ExtResource("1_item")
id = &"training_arrows"
display_name = "Training Arrows"
description = "Simple arrows compatible with bows."
category = 7
stackable = true
max_stack_size = 999
weight = 0.05
equipment_profile = SubResource("ItemEquipmentProfile_arrows")
ammunition_profile = SubResource("ItemAmmunitionProfile_arrows")
sell_price = 1
