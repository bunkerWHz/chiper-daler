[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://features/inventory/ItemData.gd" id="item"]
[ext_resource type="Texture2D" path="res://assets/icon_placeholder.png" id="icon"]
[ext_resource type="Script" path="res://features/inventory/ItemStats.gd" id="stats"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemEquipmentProfile.gd" id="equipment"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemArmorProfile.gd" id="armor"]

[sub_resource type="Resource" id="stats"]
script = ExtResource("stats")
defense = 5.0

[sub_resource type="Resource" id="equipment"]
