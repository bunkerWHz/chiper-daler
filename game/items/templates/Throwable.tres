[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://features/inventory/ItemData.gd" id="item"]
[ext_resource type="Texture2D" path="res://assets/icon_placeholder.png" id="icon"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemWeaponProfile.gd" id="weapon"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemProjectileProfile.gd" id="projectile"]

[sub_resource type="Resource" id="projectile"]
script = ExtResource("projectile")

[sub_resource type="Resource" id="weapon"]
