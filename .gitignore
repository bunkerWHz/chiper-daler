# Godot 4+ specific ignores
.godot/
/android/
.godot/addons/*
/addons/*
!/addons/soupik/
# Imported translations (automatically generated; see project.gd/import)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash_*.json

# Imported assets
Assets/.import/
Scenes/.import/
Sounds/.import/
*.import

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Obsidian vault (docs/ is the vault root; see docs/AGENTS.md)
# Shared vault config is committed; per-user UI state and caches are not.
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/cache
docs/.trash/
# A vault accidentally opened inside the config folder creates this nested copy.
docs/.obsidian/.obsidian/
