[gd_resource type="Resource" load_steps=5 format=3]

[ext_resource type="Script" path="res://features/inventory/ItemData.gd" id="1_item"]
[ext_resource type="Script" path="res://features/inventory/ItemStats.gd" id="2_stats"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemEquipmentProfile.gd" id="3_equipment"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemWeaponProfile.gd" id="4_weapon"]

[sub_resource type="Resource" id="ItemStats_crossbow"]
script = ExtResource("2_stats")
damage = 12.0
dexterity_requirement = 3

[sub_resource type="Resource" id="ItemEquipmentProfile_crossbow"]
script = ExtResource("3_equipment")
allowed_slots = Array[int]([1])
stats = SubResource("ItemStats_crossbow")

[sub_resource type="Resource" id="ItemWeaponProfile_crossbow"]
script = ExtResource("4_weapon")
combat_mode = 4
visual_archetype = 2

[resource]
script = ExtResource("1_item")
id = &"light_crossbow"
