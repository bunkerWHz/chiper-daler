[gd_resource type="Resource" load_steps=5 format=3]

[ext_resource type="Script" path="res://features/inventory/ItemData.gd" id="1_item"]
[ext_resource type="Script" path="res://features/inventory/ItemStats.gd" id="2_stats"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemEquipmentProfile.gd" id="3_equipment"]
[ext_resource type="Script" path="res://features/inventory/profiles/ItemWeaponProfile.gd" id="4_weapon"]

[sub_resource type="Resource" id="ItemStats_shield"]
script = ExtResource("2_stats")
defense = 5.0

[sub_resource type="Resource" id="ItemEquipmentProfile_shield"]
script = ExtResource("3_equipment")
allowed_slots = Array[int]([2])
stats = SubResource("ItemStats_shield")

[sub_resource type="Resource" id="ItemWeaponProfile_shield"]
script = ExtResource("4_weapon")
combat_mode = 1

[resource]
script = ExtResource("1_item")
id = &"wooden_shield"
display_name = "Wooden Shield"
description = "A light shield suited to basic guarding and parrying."
category = 1
stackable = false
max_stack_size = 1
weight = 3.0
equipment_profile = SubResource("ItemEquipmentProfile_shield")
weapon_profile = SubResource("ItemWeaponProfile_shield")
